{
  "name": "@suma/desktop",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "description": "Suma desktop shell — Electron + React (minimal daily-driver shell, PRD §8.1). Production builds use the castLabs ECS Electron for Widevine/VMP; development uses stock Electron.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist:mac": "electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 --publish never",
    "dist:mac:prod": "electron-vite build && electron-builder --mac --arm64 --config electron-builder.prod.yml --publish never",
    "release:mac": "electron-vite build && electron-builder --mac --arm64 --config electron-builder.prod.yml --publish always",
    "check-types": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "lint": "eslint src test --max-warnings 0",
    "postinstall": "node scripts/fix-node-pty-helper.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.17.0",
    "@suma/config": "workspace:*",
    "@suma/protocol": "workspace:*",
    "@suma/sync-engine": "workspace:*",
    "ai": "^7.0.58",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.31.0",
    "node-pty": "^1.1.0",
    "nostr-tools": "^2.24.1",
    "sherpa-onnx-node": "^1.13.5",
    "tldts": "^7.0.15"
  },
  "devDependencies": {
    "@ai-sdk/react": "^4.0.61",
    "@base-ui/react": "^1.7.0",
    "@pierre/diffs": "^1.3.5",
    "@pierre/trees": "1.0.0-beta.6",
    "@shadcn/react": "^0.3.0",
    "@suma/eslint-config": "workspace:*",
    "@suma/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "eslint": "^9.39.1",
    "playwright-core": "^1.62.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.0",
    "typescript": "5.9.2",
    "vite": "^6.3.0",
    "vitest": "^3.2.0",
    "zustand": "^5.0.0"
  }
}
