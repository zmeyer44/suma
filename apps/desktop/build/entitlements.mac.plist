<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the signed Suma.app (see docs/release-macos.md).

  - allow-jit / allow-unsigned-executable-memory: V8 needs both under the
    hardened runtime.
  - disable-library-validation: required to load the Widevine CDM (signed by
    Google, not by our Developer ID) in castLabs ECS builds.
  - audio-input / camera: getUserMedia for sites; the matching usage strings
    are injected via extendInfo in electron-builder.prod.yml.
  - keychain-access-groups is DELIBERATELY ABSENT (removed 2026-08-13, the
    0.0.2 launch failure): it is a RESTRICTED entitlement — without an
    embedded Developer ID provisioning profile carrying it, AMFI kills the
    app at spawn ("Launchd job spawn failed", POSIX 163) on every launch.
    Notarization does NOT catch this. Touch ID passkeys already degrade
    honestly without it (webauthn-policy.ts reports "unsigned-build" because
    SUMA_APPLE_TEAM_ID is a build-shell env var no user machine has).
    Re-adding it requires BOTH a Developer ID provisioning profile
    (portal: Profiles, type Developer ID, bundle com.sumabrowser.app;
    wire via mac.provisioningProfile in electron-builder.prod.yml) AND
    baking the team id into the app at build time. See docs/release-macos.md.
    Beware: a double hyphen is ILLEGAL inside an XML comment, and Apple's
    entitlement parser (AMFIUnserializeXML) hard-fails the signing step on
    it, so never paste flag-bearing commands into this comment.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.device.camera</key>
    <true/>
  </dict>
</plist>
