<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the signed Suma.app (see docs/release-macos.md).

  - allow-jit / allow-unsigned-executable-memory: V8 needs both under the
    hardened runtime.
  - disable-library-validation: required to load the Widevine CDM (signed by
    Google, not by our Developer ID) in castLabs ECS builds.
  - audio-input / camera: getUserMedia for sites; the matching usage strings
    are injected via extendInfo in electron-builder.prod.yml.
  - keychain-access-groups: Touch ID passkeys live here; must equal the
    runtime group <TEAM_ID>.<BUNDLE_ID>.webauthn (docs/auth-flows.md).
    NOTE: verify after signing that $(AppIdentifierPrefix) was expanded
    (codesign historically does not expand Xcode variables):
      codesign -d --entitlements - dist/mac-arm64/Suma.app | grep webauthn
    If it shows the literal "$(AppIdentifierPrefix)", replace it here with
    your team id prefix, e.g. ABCDE12345.com.sumabrowser.app.webauthn.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>keychain-access-groups</key>
    <array>
      <string>$(AppIdentifierPrefix)com.sumabrowser.app.webauthn</string>
    </array>
  </dict>
</plist>
