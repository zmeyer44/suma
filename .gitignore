# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo

# Embedded local-dev database (services/control, DATABASE_URL=pglite)
.pglite/

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist
.wrangler/
target/

# apps/desktop/build holds packaging inputs, not outputs. Raster images stay
# ignored (regenerated by scripts/build-icons.mjs from icon.svg, or from
# background.svg via rsvg-convert — see docs/release-macos.md) but the SVG
# sources and the entitlements are source.
!apps/desktop/build/
apps/desktop/build/*
!apps/desktop/build/entitlements.*.plist
!apps/desktop/build/icon.svg
!apps/desktop/build/icon.png
!apps/desktop/build/background.svg

# Local copies of the desktop DMG served by the marketing site in dev
# (production points SUMA_MAC_DMG_URL at the release bucket instead)
apps/www/public/downloads/

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local assistant/session state
.claude/

# E2E run output (screenshots, snapshots) — regenerated by the suites
/artifacts/

# Local font scratch; the site's fonts live in apps/www/src/fonts
/fonts/

# Licensed display-face files, fetched at build time by
# apps/www/scripts/fetch-fonts.mjs (the committed fallback/ stays tracked)
apps/www/src/fonts/*.woff2
apps/www/src/fonts/.fonts-source

# Misc
.DS_Store
*.pem
.env*
