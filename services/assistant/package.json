{
  "name": "@suma/assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public channel gateway and private remote assistant runner for Suma.",
  "scripts": {
    "dev": "tsx watch src/dev-server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src test --max-warnings 0"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@suma/assistant-core": "workspace:*",
    "ai": "^7.0.58",
    "hono": "^4.7.0",
    "playwright-core": "^1.62.1"
  },
  "devDependencies": {
    "@suma/eslint-config": "workspace:*",
    "@suma/typescript-config": "workspace:*",
    "@types/node": "^22.15.0",
    "eslint": "^9.39.1",
    "tsx": "^4.19.0",
    "typescript": "5.9.2",
    "vitest": "^3.2.0"
  }
}
