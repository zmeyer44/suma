{
  "name": "@suma/control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Control plane: Hono + Drizzle + Neon — accounts, devices, spaces, key wrappers, machine lifecycle, audit trail (PRD §7).",
  "scripts": {
    "dev": "tsx watch src/dev-server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc --noEmit",
