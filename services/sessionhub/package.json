  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "@suma/eslint-config": "workspace:*",
    "@suma/typescript-config": "workspace:*",
    "eslint": "^9.39.1",
    "typescript": "5.9.2",
    "vitest": "^3.2.0",
    "wrangler": "^4.20.0"
